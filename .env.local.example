# ─── Email (for contact form) ───────────────────────────────────
# Get a free API key at https://resend.com to deliver contact form
# submissions to CONTACT_EMAIL_TO below.
RESEND_API_KEY=
CONTACT_EMAIL_TO=mike@mikehuber.com

# ─── Admin Dashboard ─────────────────────────────────────────────
# Set a strong password for the admin login
ADMIN_PASSWORD=change-me-in-production
# Any long random string for signing session cookies
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ─── Site URL (used for OG tags, sitemaps) ───────────────────────
NEXT_PUBLIC_SITE_URL=https://mikehuber.com
